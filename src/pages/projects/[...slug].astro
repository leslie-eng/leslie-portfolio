---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const idx = String(project.data.order).padStart(3, "0");
const flagship = project.data.order === 1;
const repo = project.data.evidence.find((e) => e.kind === "repo");
---

<Base title={`${project.data.title} — Leslie Angu`} description={project.data.summary}>
  <article class="case-study">
    <div class="container">
      <div class="section-head">
        <span><a href="/#projects"><span class="idx">&lt;-</span> [002] PROJECTS // INDEX</a></span>
        <span>{flagship && "FLAGSHIP · "}CASE STUDY {idx}</span>
      </div>

      <header class="cs-header">
        <p class="mono discipline">{project.data.discipline}</p>
        <h1 class="display-title">{project.data.title}</h1>
        <p class="summary">{project.data.summary}</p>
      </header>

      <div class="cs-grid">
        <div class="cs-body">
          <div class="prose">
            <Content />
          </div>
        </div>

        <aside class="cs-rail">
          <div class="panel">
            <p class="panel-head mono">STACK // BILL OF MATERIALS</p>
            <ul class="stack-list mono" role="list">
              {project.data.stack.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          <div class="panel">
            <p class="panel-head mono">EVIDENCE // VERIFICATION</p>
            <ul class="evidence-list mono" role="list">
              {
                project.data.evidence.map((e) => (
                  <li>
                    {e.pending ? (
                      <span class="pending">{e.label} // PENDING</span>
                    ) : (
                      <a href={e.url} rel="noopener">
                        {e.label} -&gt;
                      </a>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
          {
            repo && (
              <div class="panel">
                <p class="panel-head mono">SOURCE // CODE</p>
                <p class="mono rail-note">
                  THE PUBLIC REPO IS LINKED UNDER EVIDENCE. PRODUCTION CODE, WHERE PRIVATE, IS
                  NOTED IN THE CASE STUDY.
                </p>
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </article>
</Base>

<style>
  .mono { font-family: var(--font-mono); }
  .idx { color: var(--accent); }
  .case-study { padding-bottom: var(--space-5); }

  .cs-header {
    padding-block: var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--hairline);
  }
  .discipline {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
  }
  .summary {
    color: var(--text-muted);
    font-size: 1.0625rem;
    max-width: var(--measure);
    margin-top: var(--space-2);
  }

  .cs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: var(--space-4);
    padding-top: var(--space-3);
  }
  .prose { max-width: var(--measure); }
  .prose :global(h2) {
    font-size: 1.375rem;
    margin-block: var(--space-3) var(--space-1);
  }
  .prose :global(p) { margin-block: var(--space-1); color: var(--text-muted); }
  .prose :global(ul) { padding-left: 1.25rem; color: var(--text-muted); }
  .prose :global(a) { color: var(--accent); }

  .cs-rail { display: flex; flex-direction: column; gap: var(--space-2); }
  .panel { border: 1px solid var(--hairline); background: var(--surface); padding: var(--space-2); }
  .panel-head {
    margin: 0 0 var(--space-1);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent);
    text-transform: uppercase;
  }
  .stack-list, .evidence-list { margin: 0; padding: 0; list-style: none; font-size: 0.75rem; letter-spacing: 0.06em; }
  .stack-list li, .evidence-list li { padding-block: 0.375rem; border-bottom: 1px dotted var(--hairline); }
  .evidence-list a { color: var(--accent); }
  .evidence-list .pending { color: var(--text-muted); font-style: italic; }
  .rail-note { font-size: 0.6875rem; color: var(--text-muted); letter-spacing: 0.08em; margin: 0; line-height: 1.7; }

  @media (max-width: 56rem) {
    .cs-grid { grid-template-columns: 1fr; }
  }
</style>
