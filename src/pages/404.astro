---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Leslie Angu">
  <section class="section lost">
    <div class="container">
      <p class="kicker">404 · signal lost</p>
      <h1>This route returned nothing.</h1>
      <p><a href="/">Back to base</a></p>
    </div>
  </section>
</Base>

<style>
  .lost {
    padding-block: var(--space-6);
  }
  h1 {
    font-size: clamp(1.75rem, 5vw, 3rem);
    margin: var(--space-2) 0 var(--space-3);
  }
</style>
