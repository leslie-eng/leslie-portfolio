---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Leslie Angu">
  <section class="lost">
    <div class="container">
      <div class="section-head">
        <span><span class="idx">[404]</span> ERROR // SIGNAL LOST</span>
        <span>ERRNO // ROUTE_NOT_FOUND</span>
      </div>
      <div class="lost-body">
        <h1 class="display-title">ROUTE RETURNED<br />NO DATA.</h1>
        <p class="mono trace">$ GET /* — 404 NOT FOUND · TRACE COMPLETE · NO SIGNAL ON THIS ROUTE</p>
        <a class="btn" href="/">[EXECUTE] RETURN TO BASE -&gt;</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost-body {
    padding-block: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .trace {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }
</style>
