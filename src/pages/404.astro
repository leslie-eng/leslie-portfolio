---
import Base from "../layouts/Base.astro";
import { profile } from "../../content/profile";
---

<Base title={`Page not found | ${profile.name}`} noindex>
  <section class="container-page py-24 sm:py-32">
    <p class="label">404</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-5xl">This page doesn't exist.</h1>
    <p class="mt-4 max-w-xl text-lg text-muted">The link may be out of date. The projects and contact details are all on the home page.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Go to home page</a>
      <a href="/#projects" class="btn-secondary">View projects</a>
    </div>
  </section>
</Base>
