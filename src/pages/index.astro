---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, profile, resume, experience, skills, certifications, about } from "../../content/profile";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const dates = (j: (typeof experience)[number]) =>
  j.start ? `${j.start} – ${j.end ?? "Present"}` : j.end === "Present" ? "Current" : "";
---

<Base title={site.title}>
  <!-- Hero -->
  <section class="container-page pt-10 pb-16 sm:pt-20 sm:pb-24" aria-labelledby="hero-name">
    <p class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-3 py-1 text-sm text-muted">
      <span class="size-2 rounded-full bg-accent-fill" aria-hidden="true"></span>
      {profile.availability}
    </p>
    <h1 id="hero-name" class="mt-6 text-4xl font-bold sm:text-6xl">{profile.name}</h1>
    <p class="mt-3 max-w-3xl text-xl font-semibold text-accent sm:text-2xl">{profile.title}</p>
    <p class="mt-5 max-w-2xl text-lg text-muted">{profile.value.join(" ")}</p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Highlights">
      {profile.proof.map((p) => (
        <li class="rounded-md border border-line bg-surface px-3 py-1.5 font-mono text-sm">{p}</li>
      ))}
    </ul>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#projects" class="btn-primary">View projects</a>
      <a href={resume.href} class="btn-secondary" download>
        Download résumé
        <span class="font-mono text-xs font-normal text-muted">PDF</span>
      </a>
    </div>
    <p class="mt-3 text-sm text-muted">Résumé updated {resume.updated}</p>
  </section>

  <!-- Projects -->
  <section id="projects" class="section" aria-labelledby="projects-title">
    <div class="container-page">
      <h2 id="projects-title" class="section-title">Projects</h2>
      <p class="mt-2 max-w-2xl text-muted">Data engineering first. Each one links to a case study with the architecture, testing approach and results.</p>
      <div class="mt-10 grid gap-6">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class="section" aria-labelledby="experience-title">
    <div class="container-page">
      <h2 id="experience-title" class="section-title">Experience</h2>
      <ol class="mt-10 space-y-10 border-l border-line pl-6 sm:pl-8">
        {experience.map((j) => (
          <li class="relative">
            <span class="absolute top-2 -left-[1.85rem] size-3 rounded-full border-2 border-accent bg-bg sm:-left-[2.35rem]" aria-hidden="true"></span>
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h3 class="text-lg font-semibold">
                {j.role} <span class="text-muted">· {j.company}</span>
              </h3>
              {dates(j) && <p class="label shrink-0">{dates(j)}</p>}
            </div>
            <ul class="mt-3 max-w-3xl list-disc space-y-2 pl-5 text-muted marker:text-accent">
              {j.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="section" aria-labelledby="skills-title">
    <div class="container-page">
      <h2 id="skills-title" class="section-title">Skills</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
        <div class="rounded-2xl border border-accent/40 bg-surface p-6 sm:p-8">
          <h3 class="text-xl font-bold">{skills.primary.name}</h3>
          <ul class="mt-5 flex flex-wrap gap-2.5">
            {skills.primary.items.map((s) => (
              <li class="rounded-lg border border-line-strong bg-surface-2 px-3 py-2 text-base">{s}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
          <h3 class="text-lg font-semibold">{skills.secondary.name}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {skills.secondary.items.map((s) => <li class="rounded-lg border border-line bg-surface-2 px-3 py-1.5 text-sm">{s}</li>)}
          </ul>
        </div>
      </div>
      <p class="mt-6 text-muted">
        <span class="font-semibold text-fg">{skills.range.name}:</span> {skills.range.line}
      </p>
    </div>
  </section>

  <!-- Certifications -->
  <section id="certifications" class="section" aria-labelledby="certs-title">
    <div class="container-page">
      <h2 id="certs-title" class="section-title">Certifications</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {certifications.completed.map((c) => (
          <li class="flex flex-col rounded-2xl border border-line bg-surface p-6">
            <h3 class="font-semibold">{c.name}</h3>
            <p class="mt-1 text-muted">{c.issuer}{c.year && ` · ${c.year}`}</p>
            {c.verify && (
              <a href={c.verify} class="link mt-4 text-sm font-semibold" rel="noopener">
                Verify credential<span class="sr-only">: {c.name}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
      <p class="mt-6 text-muted">
        <span class="font-semibold text-fg">In progress:</span> {certifications.inProgress.join(" · ")}
      </p>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section" aria-labelledby="about-title">
    <div class="container-page grid gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 id="about-title" class="section-title">About</h2>
        <div class="mt-6 max-w-2xl space-y-4 text-lg text-muted">
          {about.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <dl class="grid content-start gap-4 rounded-2xl border border-line bg-surface p-6 text-base">
        <div><dt class="label">Based in</dt><dd class="mt-1">{profile.location}</dd></div>
        <div><dt class="label">Education</dt><dd class="mt-1">{profile.education.degree}, {profile.education.school}</dd></div>
        <div><dt class="label">Founder</dt><dd class="mt-1">Kinetic Kraft Robotics</dd></div>
        <div><dt class="label">Languages</dt><dd class="mt-1">{profile.languages.join(", ")}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container-page">
      <h2 id="contact-title" class="section-title">Contact</h2>
      <p class="mt-2 max-w-2xl text-lg text-muted">
        Hiring for a data engineering role? Email is the fastest way to reach me.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <div class="flex items-stretch overflow-hidden rounded-lg border border-line-strong">
          <a href={`mailto:${profile.email}`} class="flex items-center px-4 py-2.5 font-mono text-base hover:text-accent">{profile.email}</a>
          <button
            type="button"
            id="copy-email"
            data-email={profile.email}
            class="min-h-11 border-l border-line-strong bg-surface-2 px-4 text-sm font-semibold hover:text-accent"
          >Copy</button>
        </div>
        <a href={profile.github} class="btn-secondary" rel="noopener">GitHub</a>
        <a href={profile.linkedin} class="btn-secondary" rel="noopener">LinkedIn</a>
        <a href={resume.href} class="btn-primary" download>Download résumé</a>
      </div>
      <p id="copy-status" class="mt-3 h-6 text-sm text-accent" role="status" aria-live="polite"></p>
    </div>
  </section>
</Base>

<script>
  const btn = document.getElementById("copy-email") as HTMLButtonElement | null;
  const status = document.getElementById("copy-status");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email ?? "");
      btn.textContent = "Copied";
      if (status) status.textContent = "Email address copied to clipboard.";
    } catch {
      if (status) status.textContent = "Couldn't copy — select the address instead.";
    }
    setTimeout(() => {
      btn.textContent = "Copy";
      if (status) status.textContent = "";
    }, 2500);
  });
</script>
