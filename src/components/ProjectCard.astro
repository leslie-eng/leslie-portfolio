---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const href = `/projects/${project.id}/`;
---

<article class:list={["card", { featured }]}>
  <p class="kicker">
    {
      project.data.order === 1 ? (
        <span>
          Flagship · Case Study {String(project.data.order).padStart(2, "0")}
        </span>
      ) : (
        <span>Case Study {String(project.data.order).padStart(2, "0")}</span>
      )
    }
  </p>
  <h3><a href={href}>{project.data.title}</a></h3>
  <p class="summary">{project.data.summary}</p>
  <ul class="stack" role="list">
    {project.data.stack.map((s) => <li>{s}</li>)}
  </ul>
  <p class="evidence">
    <span class="evidence-label">Evidence:</span>
    {
      project.data.evidence.map((e) =>
        e.pending ? (
          <span class="badge pending">{e.label}</span>
        ) : (
          <a class="badge" href={e.url} rel="noopener">
            {e.label}
          </a>
        )
      )
    }
  </p>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .card.featured {
    border-color: var(--accent);
  }
  h3 {
    margin: 0;
    font-size: 1.375rem;
  }
  h3 a {
    color: var(--text);
  }
  h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .summary {
    color: var(--text-muted);
    margin: 0;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.125rem 0.625rem;
  }
  .evidence {
    margin: 0;
    font-size: 0.875rem;
    display: flex;
    gap: var(--space-1);
    align-items: center;
    flex-wrap: wrap;
  }
  .evidence-label {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: var(--radius);
    padding: 0.125rem 0.5rem;
  }
  .badge:hover {
    text-decoration: none;
    background: var(--accent-dim);
  }
  .badge.pending {
    border-color: var(--line);
    color: var(--text-muted);
    border-style: dashed;
  }
</style>
