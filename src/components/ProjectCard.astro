---
import type { CollectionEntry } from "astro:content";
import ArchDiagram from "./ArchDiagram.astro";
import { outcomeOverrides } from "../../content/profile";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const href = `/projects/${project.id}/`;
const outcome = outcomeOverrides[project.id] ?? data.outcome;
---

<article class="group grid gap-6 rounded-2xl border border-line bg-surface p-5 transition-colors hover:border-line-strong sm:p-7 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-center">
  <div class="min-w-0">
    <p class="label">{data.discipline}</p>
    <h3 class="mt-2 text-xl font-bold sm:text-2xl">
      <a href={href} class="hover:text-accent">{data.title}</a>
    </h3>
    <p class="mt-2 text-muted">{data.problem}</p>

    <div class="mt-4 rounded-lg border-l-2 border-accent bg-accent-soft px-4 py-3">
      <p class="label !text-accent">Outcome</p>
      <p class="mt-1 font-medium">{outcome}</p>
    </div>

    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Stack">
      {data.tags.map((t) => <li class="tag">{t}</li>)}
    </ul>

    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold">
      <a href={href} class="link">Case study<span class="sr-only">: {data.title}</span></a>
      {data.links.live && (
        <a href={data.links.live} class="link" rel="noopener">Live site<span class="sr-only">: {data.title}</span></a>
      )}
      {data.links.repo && (
        <a href={data.links.repo} class="link" rel="noopener">Repo<span class="sr-only">: {data.title}</span></a>
      )}
    </div>
  </div>

  <a href={href} class="block overflow-hidden rounded-xl border border-line bg-bg p-3" tabindex="-1" aria-hidden="true">
    <ArchDiagram diagram={data.diagram} title={data.title} compact />
  </a>
</article>
